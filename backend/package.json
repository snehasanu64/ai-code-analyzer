{
  "name": "ai-code-analyzer-backend",
  "version": "1.0.0",
  "engines": {
    "node": ">=18"
  },
  "description": "AI Code Analyzer - Backend API (Node.js, Express, MongoDB)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
