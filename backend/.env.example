# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_code_analyzer?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Encryption key used to store each user's personal LLM API key (Workspace Keys) at rest.
# Any long random string works — generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=f1957403e688c19154aa24645f404303e799e3eb375aa239c34d661c35995d93

# Global fallback AI Provider (mock | gemini | openai | claude), used when a user has not
# configured their own Workspace Keys (Profile → Workspace Keys). "mock" needs no API key.
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# File uploads
MAX_FILE_SIZE_MB=5
