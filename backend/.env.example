PORT=5000
NODE_ENV=production
CLIENT_URL=http://<EC2_PUBLIC_IP>

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net/ai_code_analyzer

# JWT Secrets (Must match Render so existing user login tokens work)
JWT_SECRET=your_same_jwt_secret_from_render
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_same_jwt_refresh_secret_from_render
JWT_REFRESH_EXPIRES_IN=30d

# Encryption Key (MUST match Render to decrypt stored user API keys)
ENCRYPTION_KEY=your_same_64_char_hex_encryption_key_from_render

# AI Provider Configuration
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MAX_FILE_SIZE_MB=5

# Transactional Email (Brevo / Resend)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_USER=snehasanu7353@gmail.com
EMAIL_PASS=your_app_password
